/* ==========================================
   CONFIGURACIÓN GENERAL
========================================== */

* {

    margin: 0;

    padding: 0;

    box-sizing: border-box;

}


html {

    scroll-behavior: smooth;

}


body {

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    background: #fff8fb;

    color: #333;

    line-height: 1.6;

}


a {

    text-decoration: none;

}


button {

    font-family: inherit;

}



/* ==========================================
   ENCABEZADO
========================================== */

.encabezado {

    width: 100%;

    min-height: 75px;

    background: white;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 15px 6%;

    box-shadow:
        0 2px 12px rgba(0, 0, 0, 0.08);

    position: sticky;

    top: 0;

    z-index: 1000;

}


.logo {

    font-size: 25px;

    font-weight: bold;

    color: #d85b91;

}


.navegacion {

    display: flex;

    gap: 30px;

}


.navegacion a {

    color: #555;

    font-weight: 600;

    transition: 0.3s;

}


.navegacion a:hover {

    color: #d85b91;

}


.carrito-btn {

    border: none;

    background: #d85b91;

    color: white;

    padding: 11px 18px;

    border-radius: 25px;

    cursor: pointer;

    font-weight: bold;

    transition: 0.3s;

}


.carrito-btn:hover {

    transform: translateY(-2px);

}



/* ==========================================
   HERO
========================================== */

.hero {

    min-height: 550px;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 60px 20px;

    background:
        linear-gradient(
            135deg,
            #ffe5ef,
            #fff8fb,
            #fce8f2
        );

}


.hero-contenido {

    max-width: 700px;

}


.pequeno {

    color: #d85b91;

    font-size: 15px;

    font-weight: bold;

    letter-spacing: 3px;

    margin-bottom: 10px;

}


.hero h1 {

    font-family: Georgia, serif;

    font-size: clamp(
        50px,
        8vw,
        90px
    );

    color: #c84d83;

    margin-bottom: 20px;

}


.hero-texto {

    font-size: 20px;

    color: #555;

    margin-bottom: 30px;

}



/* ==========================================
   BOTONES GENERALES
========================================== */

.boton {

    display: inline-block;

    background: #d85b91;

    color: white;

    padding: 13px 28px;

    border-radius: 30px;

    font-weight: bold;

    transition: 0.3s;

}


.boton:hover {

    background: #bd4478;

    transform: translateY(-2px);

}



/* ==========================================
   SECCIÓN PRODUCTOS
========================================== */

.productos-section {

    padding: 80px 6%;

    max-width: 1400px;

    margin: auto;

}


.productos-section h2 {

    text-align: center;

    font-family: Georgia, serif;

    font-size: 40px;

    color: #c84d83;

    margin-bottom: 10px;

}


.subtitulo {

    text-align: center;

    color: #777;

    margin-bottom: 30px;

}



/* ==========================================
   CATEGORÍAS
========================================== */

.categorias {

    display: flex;

    justify-content: center;

    align-items: center;

    flex-wrap: wrap;

    gap: 12px;

    margin: 30px auto 45px;

}


.categoria-btn {

    padding: 11px 22px;

    border: 2px solid #d85b91;

    background: white;

    color: #d85b91;

    border-radius: 30px;

    cursor: pointer;

    font-size: 15px;

    font-weight: bold;

    transition: 0.3s;

}


.categoria-btn:hover {

    background: #d85b91;

    color: white;

    transform: translateY(-2px);

}


.categoria-btn.activo {

    background: #d85b91;

    color: white;

}



/* ==========================================
   CUADRÍCULA DE PRODUCTOS
========================================== */

.productos-grid {

    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(240px, 1fr)
        );

    gap: 28px;

}



/* ==========================================
   TARJETA DE PRODUCTO
========================================== */

.producto {

    background: white;

    border-radius: 18px;

    overflow: hidden;

    box-shadow:
        0 5px 20px
        rgba(0, 0, 0, 0.08);

    transition: 0.3s;

}


.producto:hover {

    transform: translateY(-6px);

    box-shadow:
        0 12px 28px
        rgba(0, 0, 0, 0.12);

}


.producto-imagen {

    width: 100%;

    height: 280px;

    background: #f8edf2;

    overflow: hidden;

}


.producto-imagen img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;

    transition: 0.4s;

}


.producto:hover
.producto-imagen img {

    transform: scale(1.04);

}


.producto-info {

    padding: 20px;

}


.producto-categoria {

    display: inline-block;

    font-size: 12px;

    color: #d85b91;

    background: #fff0f6;

    padding: 5px 10px;

    border-radius: 15px;

    margin-bottom: 10px;

}


.producto-info h3 {

    font-size: 21px;

    color: #333;

    margin-bottom: 8px;

}


.producto-info p {

    color: #777;

    font-size: 14px;

    min-height: 45px;

    margin-bottom: 12px;

}


.precio {

    color: #c84d83;

    font-size: 23px;

    font-weight: bold;

    margin-bottom: 15px;

}


.agregar-btn {

    width: 100%;

    border: none;

    background: #d85b91;

    color: white;

    padding: 12px;

    border-radius: 25px;

    cursor: pointer;

    font-weight: bold;

    transition: 0.3s;

}


.agregar-btn:hover {

    background: #bd4478;

}



/* ==========================================
   SIN PRODUCTOS
========================================== */

.sin-productos {

    grid-column: 1 / -1;

    text-align: center;

    padding: 50px;

    color: #777;

}



/* ==========================================
   CARRITO
========================================== */

.carrito {

    display: none;

    position: fixed;

    z-index: 2000;

    left: 0;

    top: 0;

    width: 100%;

    height: 100%;

    background:
        rgba(0, 0, 0, 0.55);

    align-items: center;

    justify-content: center;

    padding: 20px;

}


.carrito-contenido {

    position: relative;

    background: white;

    width: 100%;

    max-width: 550px;

    max-height: 90vh;

    overflow-y: auto;

    border-radius: 20px;

    padding: 30px;

}


.carrito-contenido h2 {

    color: #c84d83;

    margin-bottom: 20px;

}


.cerrar {

    position: absolute;

    right: 18px;

    top: 15px;

    border: none;

    background: transparent;

    font-size: 25px;

    cursor: pointer;

    color: #555;

}


.cerrar:hover {

    color: #d85b91;

}



/* ==========================================
   PRODUCTOS DEL CARRITO
========================================== */

.item-carrito {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    padding: 15px 0;

    border-bottom: 1px solid #eee;

}


.item-carrito div {

    display: flex;

    flex-direction: column;

}


.item-carrito strong {

    color: #333;

}


.item-carrito span {

    color: #c84d83;

    font-weight: bold;

}


.eliminar-btn {

    border: none;

    background: transparent;

    cursor: pointer;

    font-size: 18px;

}


.carrito-vacio {

    text-align: center;

    color: #777;

    padding: 30px 0;

}


.total {

    margin-top: 20px;

    margin-bottom: 20px;

}


.total h3 {

    color: #333;

    font-size: 22px;

}


#total-carrito {

    color: #c84d83;

}



/* ==========================================
   WHATSAPP
========================================== */

.whatsapp {

    width: 100%;

    border: none;

    background: #25D366;

    color: white;

    padding: 14px;

    border-radius: 30px;

    cursor: pointer;

    font-size: 16px;

    font-weight: bold;

    transition: 0.3s;

}


.whatsapp:hover {

    background: #1faa53;

    transform: translateY(-2px);

}



/* ==========================================
   CONTACTO
========================================== */

.contacto {

    text-align: center;

    padding: 80px 20px;

    background: #ffeaf2;

}


.contacto h2 {

    font-family: Georgia, serif;

    color: #c84d83;

    font-size: 38px;

    margin-bottom: 10px;

}


.contacto p {

    color: #666;

    margin-bottom: 25px;

}



/* ==========================================
   FOOTER
========================================== */

footer {

    text-align: center;

    padding: 25px 20px;

    background: #c84d83;

    color: white;

    font-size: 14px;

}



/* ==========================================
   CELULARES
========================================== */

@media (max-width: 768px) {


    .encabezado {

        flex-wrap: wrap;

        gap: 15px;

        padding: 15px 20px;

    }


    .logo {

        font-size: 21px;

    }


    .navegacion {

        order: 3;

        width: 100%;

        justify-content: center;

        gap: 20px;

    }


    .navegacion a {

        font-size: 14px;

    }


    .carrito-btn {

        font-size: 13px;

    }


    .hero {

        min-height: 450px;

    }


    .hero h1 {

        font-size: 55px;

    }


    .hero-texto {

        font-size: 17px;

    }


    .productos-section {

        padding: 60px 20px;

    }


    .productos-section h2 {

        font-size: 32px;

    }


    .producto-imagen {

        height: 260px;

    }


    .carrito-contenido {

        padding: 25px 20px;

    }

}
